<%@ page pageEncoding="UTF-8" %>
<%
    // =========================================================================
    // Avatar de cuenta para un usuario con sesion iniciada: circulo con la
    // inicial del primer nombre + primer nombre y primer apellido (nunca una
    // foto). El desplegable usa el componente nativo de Bootstrap
    // (data-bs-toggle="dropdown"), por lo que la pagina que incluye este
    // JSPF debe cargar bootstrap.bundle.min.js (ver jspf/scripts-panel.jspf).
    //
    // Se apoya UNICAMENTE en atributos de sesion (nombreUsuario,
    // apellidosUsuario, roles), cacheados por login.jsp y refrescados por
    // cliente/perfil.jsp -- no abre una segunda conexion a la base de datos.
    // =========================================================================
    String hgAvNombre = (String) session.getAttribute("nombreUsuario");
    String hgAvApellidos = (String) session.getAttribute("apellidosUsuario");

    @SuppressWarnings("unchecked")
    java.util.List<String> hgAvRoles = (java.util.List<String>) session.getAttribute("roles");

    String hgAvPrimerNombre = (hgAvNombre != null && !hgAvNombre.trim().isEmpty())
            ? hgAvNombre.trim().split("\\s+")[0] : "";
    String hgAvPrimerApellido = (hgAvApellidos != null && !hgAvApellidos.trim().isEmpty())
            ? hgAvApellidos.trim().split("\\s+")[0] : "";

    String hgAvNombreCorto = !hgAvPrimerNombre.isEmpty()
            ? (!hgAvPrimerApellido.isEmpty() ? hgAvPrimerNombre + " " + hgAvPrimerApellido : hgAvPrimerNombre)
            : "Usuario";
    String hgAvInicial = !hgAvPrimerNombre.isEmpty() ? hgAvPrimerNombre.substring(0, 1).toUpperCase() : "?";

    String hgAvPanel = request.getContextPath() + "/cliente/dashboard-cliente.jsp";
    if (hgAvRoles != null && hgAvRoles.contains("Administrador")) {
        hgAvPanel = request.getContextPath() + "/administrador/dashboard-administrador.jsp";
    } else if (hgAvRoles != null && hgAvRoles.contains("Inmobiliaria")) {
        hgAvPanel = request.getContextPath() + "/inmobiliaria/dashboard-inmobiliaria.jsp";
    }
%>
<div class="hg-cuenta dropdown" id="hg-cuenta">
    <button type="button" class="hg-avatar-trigger dropdown-toggle" id="hg-avatar-trigger"
            data-bs-toggle="dropdown" aria-expanded="false">
        <span class="hg-avatar hg-avatar--inicial"><%= hgAvInicial %></span>
        <span class="hg-avatar-trigger__nombre"><%= hgAvNombreCorto %></span>
        <i class="bi bi-chevron-down hg-avatar-trigger__caret"></i>
    </button>
    <div class="dropdown-menu dropdown-menu-end hg-cuenta-menu" aria-labelledby="hg-avatar-trigger">
        <a class="dropdown-item" href="<%= hgAvPanel %>"><i class="bi bi-speedometer2"></i> Mi panel</a>
        <a class="dropdown-item" href="<%= request.getContextPath() %>/logout.jsp"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
    </div>
</div>
