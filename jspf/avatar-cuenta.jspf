<%@ page pageEncoding="UTF-8" %>
<%
    // =========================================================================
    // Avatar de cuenta para un usuario con sesion iniciada: circulo con la
    // inicial del nombre + nombre y apellido. Al hacer clic despliega un
    // recuadro simple (NO un modal de Bootstrap) con "Mi panel" y "Cerrar
    // sesion". Se implementa con JS propio (ver assets/js/main.js), sin
    // backdrop ni libreria de modales, para evitar que quede atrapado
    // dentro de contenedores con overflow:hidden (como el menu movil
    // colapsable), que es lo que rompia la version anterior.
    //
    // Se apoya UNICAMENTE en atributos de sesion (nombreUsuario,
    // apellidosUsuario, roles), cacheados por login.jsp y refrescados por
    // cliente/perfil.jsp -- no abre una segunda conexion a la base de datos.
    // =========================================================================
    String hgAvNombre = (String) session.getAttribute("nombreUsuario");
    String hgAvApellidos = (String) session.getAttribute("apellidosUsuario");

    @SuppressWarnings("unchecked")
    java.util.List<String> hgAvRoles = (java.util.List<String>) session.getAttribute("roles");

    String hgAvNombreCompleto = hgAvNombre != null
            ? (hgAvApellidos != null && !hgAvApellidos.isEmpty() ? hgAvNombre + " " + hgAvApellidos : hgAvNombre)
            : "Usuario";
    String hgAvInicial = (hgAvNombre != null && !hgAvNombre.isEmpty()) ? hgAvNombre.substring(0, 1).toUpperCase() : "?";

    String hgAvPanel = request.getContextPath() + "/cliente/dashboard-cliente.jsp";
    if (hgAvRoles != null && hgAvRoles.contains("Administrador")) {
        hgAvPanel = request.getContextPath() + "/administrador/dashboard-administrador.jsp";
    } else if (hgAvRoles != null && hgAvRoles.contains("Inmobiliaria")) {
        hgAvPanel = request.getContextPath() + "/inmobiliaria/dashboard-inmobiliaria.jsp";
    }
%>
<div class="hg-cuenta" id="hg-cuenta">
    <button type="button" class="hg-avatar-trigger" id="hg-avatar-trigger" aria-haspopup="true" aria-expanded="false">
        <span class="hg-avatar hg-avatar--inicial"><%= hgAvInicial %></span>
        <span class="hg-avatar-trigger__nombre"><%= hgAvNombreCompleto %></span>
        <i class="bi bi-chevron-down hg-avatar-trigger__caret"></i>
    </button>
    <div class="hg-cuenta-menu" role="menu">
        <a role="menuitem" href="<%= hgAvPanel %>"><i class="bi bi-speedometer2"></i> Mi panel</a>
        <a role="menuitem" href="<%= request.getContextPath() %>/logout.jsp"><i class="bi bi-box-arrow-right"></i> Cerrar sesion</a>
    </div>
</div>
