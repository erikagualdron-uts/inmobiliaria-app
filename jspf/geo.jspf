<%@ page pageEncoding="UTF-8" %>
<%!
    // =========================================================================
    // Genera una coordenada aleatoria dentro del area urbana real de una
    // ciudad del catalogo (no en cualquier punto del mapa), para simular la
    // ubicacion de una propiedad cuando no se cuenta con una direccion
    // geocodificada real. Los rangos son aproximaciones razonables del area
    // urbana de cada ciudad (no limites administrativos exactos), suficientes
    // para que el marcador caiga siempre dentro de la ciudad correspondiente.
    //
    // Si el nombre de ciudad no esta en el mapa (ej. una ciudad nueva que el
    // administrador agrego desde Catalogos), cae en un rango generico del
    // centro de Colombia en vez de fallar.
    // =========================================================================
    private static final java.util.Map<String, double[]> HG_BBOX_CIUDADES = new java.util.HashMap<>();
    static {
        // {latMin, latMax, lngMin, lngMax}
        HG_BBOX_CIUDADES.put("Bucaramanga",   new double[]{7.0850, 7.1400, -73.1350, -73.1000});
        HG_BBOX_CIUDADES.put("Floridablanca", new double[]{7.0350, 7.0850, -73.1050, -73.0650});
        HG_BBOX_CIUDADES.put("Girón",         new double[]{7.0500, 7.0900, -73.1850, -73.1550});
        HG_BBOX_CIUDADES.put("Piedecuesta",   new double[]{6.9700, 7.0150, -73.0750, -73.0300});
        HG_BBOX_CIUDADES.put("Bogotá",        new double[]{4.5900, 4.7900, -74.1400, -74.0400});
        HG_BBOX_CIUDADES.put("Medellín",      new double[]{6.2100, 6.2900, -75.6050, -75.5450});
        HG_BBOX_CIUDADES.put("Cali",          new double[]{3.3900, 3.4700, -76.5600, -76.4950});
        HG_BBOX_CIUDADES.put("Barranquilla",  new double[]{10.9400, 11.0100, -74.8200, -74.7500});
        HG_BBOX_CIUDADES.put("Cartagena",     new double[]{10.3900, 10.4400, -75.5400, -75.4700});
        HG_BBOX_CIUDADES.put("Bello",         new double[]{6.3150, 6.3600, -75.5800, -75.5450});
    }
    private static final double[] HG_BBOX_DEFECTO = {4.0, 8.0, -76.0, -73.5};

    private double[] hgCoordenadaAleatoriaCiudad(String nombreCiudad) {
        double[] bbox = HG_BBOX_CIUDADES.getOrDefault(nombreCiudad, HG_BBOX_DEFECTO);
        double lat = bbox[0] + Math.random() * (bbox[1] - bbox[0]);
        double lng = bbox[2] + Math.random() * (bbox[3] - bbox[2]);
        return new double[]{
            Math.round(lat * 10000000.0) / 10000000.0,
            Math.round(lng * 10000000.0) / 10000000.0
        };
    }
%>
