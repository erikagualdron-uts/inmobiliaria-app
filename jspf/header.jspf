<%@ page pageEncoding="UTF-8" %>
<%
    // Header incluido en las paginas publicas. Si hay sesion iniciada se
    // muestra el avatar de la cuenta (con acceso directo a "Mi panel") en
    // vez de los botones de acceso, para que nunca se sienta como una
    // perdida de sesion el navegar a una pagina publica estando logueado.
    Object idUsuarioSesion = session.getAttribute("idUsuario");
%>
<header class="hg-navbar" id="hg-navbar">
    <div class="hg-navbar__inner">
        <a class="hg-brand" href="<%= request.getContextPath() %>/index.jsp">
            <svg class="hg-brand__mark" width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 15L16 5L28 15" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M7 13V26H25V13" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M13 26V19H19V26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Hogaria</span>
        </a>

        <nav class="hg-navmenu" id="hg-navmenu">
            <a href="<%= request.getContextPath() %>/catalogo.jsp">Propiedades</a>
            <a href="<%= request.getContextPath() %>/index.jsp#nosotros">Nosotros</a>
            <a href="<%= request.getContextPath() %>/index.jsp#contacto">Contacto</a>

            <% if (idUsuarioSesion == null) { %>
            <div class="hg-navmenu__auth">
                <a class="hg-btn hg-btn--ghost" href="<%= request.getContextPath() %>/login.jsp">Iniciar sesion</a>
                <a class="hg-btn hg-btn--solid" href="<%= request.getContextPath() %>/registro.jsp">Registrarse</a>
            </div>
            <% } %>
        </nav>

        <!--
            El avatar de cuenta vive FUERA del <nav> colapsable de arriba a
            proposito: en movil, ese <nav> se oculta con overflow:hidden
            cuando esta cerrado, y eso se comia (invisible pero "abierto")
            cualquier menu propio que quedara dentro de el. Aqui siempre
            queda visible, junto al boton de hamburguesa.
        -->
        <div class="hg-navbar__right">
            <% if (idUsuarioSesion != null) { %>
                <%@ include file="/jspf/avatar-cuenta.jspf" %>
            <% } %>
            <button class="hg-navbar__toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="hg-navmenu" id="hg-navbar-toggle">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>
