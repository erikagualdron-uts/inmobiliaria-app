<%@ page pageEncoding="UTF-8" %>
<%
    // Barra superior para paginas internas ya protegidas por seguridad.jspf.
    @SuppressWarnings("unchecked")
    java.util.List<String> hgRolesPanel = (java.util.List<String>) session.getAttribute("roles");
%>
<header class="hg-panel-topbar">
    <div class="hg-panel-topbar__inner">
        <a class="hg-brand" href="<%= request.getContextPath() %>/index.jsp">
            <svg class="hg-brand__mark" width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 15L16 5L28 15" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M7 13V26H25V13" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M13 26V19H19V26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Hogaria</span>
        </a>

        <nav class="hg-panel-nav">
            <% if (hgRolesPanel != null && hgRolesPanel.contains("Inmobiliaria")) { %>
            <a href="<%= request.getContextPath() %>/inmobiliaria/mis-propiedades.jsp"><i class="bi bi-houses"></i> Mis propiedades</a>
            <a href="<%= request.getContextPath() %>/inmobiliaria/citas-recibidas.jsp"><i class="bi bi-calendar-check"></i> Citas</a>
            <a href="<%= request.getContextPath() %>/inmobiliaria/solicitudes-recibidas.jsp"><i class="bi bi-clipboard-check"></i> Solicitudes</a>
            <a href="<%= request.getContextPath() %>/inmobiliaria/reportes.jsp"><i class="bi bi-graph-up"></i> Reportes</a>
            <% } %>
            <% if (hgRolesPanel != null && hgRolesPanel.contains("Cliente")) { %>
            <a href="<%= request.getContextPath() %>/cliente/mis-citas.jsp"><i class="bi bi-calendar-check"></i> Mis citas</a>
            <a href="<%= request.getContextPath() %>/cliente/mis-solicitudes.jsp"><i class="bi bi-clipboard-check"></i> Mis solicitudes</a>
            <a href="<%= request.getContextPath() %>/cliente/favoritos.jsp"><i class="bi bi-heart"></i> Favoritos</a>
            <% } %>
            <% if (hgRolesPanel != null && hgRolesPanel.contains("Administrador")) { %>
            <a href="<%= request.getContextPath() %>/administrador/reportes.jsp"><i class="bi bi-graph-up"></i> Reportes</a>
            <a href="<%= request.getContextPath() %>/administrador/usuarios.jsp"><i class="bi bi-people"></i> Usuarios</a>
            <a href="<%= request.getContextPath() %>/administrador/catalogos.jsp"><i class="bi bi-tags"></i> Catalogos</a>
            <a href="<%= request.getContextPath() %>/administrador/auditoria.jsp"><i class="bi bi-journal-text"></i> Auditoria</a>
            <% } %>
        </nav>

        <div class="hg-panel-topbar__user">
            <%@ include file="/jspf/avatar-cuenta.jspf" %>
        </div>
    </div>
</header>
