<%@ page pageEncoding="UTF-8" %>
<%--
    Script comun para las paginas internas del panel (protegidas por
    seguridad.jspf). Carga el bundle de Bootstrap (incluye Popper), del que
    depende el menu desplegable de la cuenta en avatar-cuenta.jspf, y
    assets/js/main.js (toasts, spinners de envio, modal de confirmacion,
    navbar con scroll, etc. -- las paginas publicas lo cargan por su cuenta,
    pero las de panel dependian solo de este include y hasta ahora nunca lo
    traian). Se incluye justo antes de "</body>" en cada pagina del panel.
--%>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="<%= request.getContextPath() %>/assets/js/main.js"></script>
